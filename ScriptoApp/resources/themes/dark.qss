/* ============================================================
   SCRIPTO DARK THEME
   ============================================================

   Palette
   ------------------------------------------------------------
   Background       #171717
   Surface          #262626
   Surface Light    #2C2C2C
   Border           #404040

   Primary Text     #E0E0E0
   Secondary Text   #999999
   Placeholder      #616161
   Disabled Text    #555555

   Success          #13FC13
   Success Hover    #24FF24
   Success Pressed  #0ED10E

   Danger           #FC2C13
   Danger Hover     #FF4530
   Danger Pressed  #D9210D

   Selection        #404040
   Scroll Track     #1F1F1F
   ============================================================ */


/* ============================================================
   GLOBAL
   ============================================================ */
* {
    font-family: "Cairo";
}

QWidget {
    outline: none;
}

QLabel[styleTag="windowTitle"] {
    color: #E0E0E0;
    font-size: 14px;
    margin: 0;
    padding: 0;
}

QLabel[styleTag="primaryLabel"] {
    font-size: 14px;
}

QLabel[styleTag="primaryLabel"][state="enabled"] {
    color: #E0E0E0; 
    
}

QLabel[styleTag="primaryLabel"][state="disabled"] {
    color: #4D4D4D;
}

QPushButton {
    color: #E0E0E0;
    font-size: 12px;
    border-radius: 5px;
    height: 30px;
    min-width: 60px;
    padding: 7px;
}

QPushButton[state="disabled"] {
    background-color: #4D4D4D;
}

QpushButton[styleTag="crossBtn"] {
    width: 20px;
    height: 20px;
    image: url('resources/icons/cross.png');
}

QPushButton[styleTag="darkRedBtn"][state="enabled"] {
    background-color: #A00303;
}

QPushButton[styleTag="paleGreenBtn"][state="enabled"] {
    background-color: #3B783B;
}

QLineEdit[styleTag="primaryLineEdit"] {
    border-radius: 5px;
    padding: 7px;
    font-size: 14px; 
    height: 30px;
    selection-background-color: #404040;
}

QLineEdit[styleTag="primaryLineEdit"][state="enabled"] {
    background-color: #262626;
    color: #E0E0E0;
}


QLineEdit[styleTag="primaryLineEdit"][state="disabled"] {
    background-color: #4D4D4D;
    color: #808080;
}

QLineEdit[styleTag="primaryLineEdit"] QAbstractItemView {
    padding: 10px;
}

QPlainTextEdit[styleTag="primaryTextArea"] {
    border-radius: 5px;
    padding: 3px;
    font-size: 14px;
}

QPlainTextEdit[styleTag="primaryTextArea"][state="enabled"] {
    background-color: #262626;
    color: #E0E0E0; 
}

QPlainTextEdit[styleTag="primaryTextArea"][state="disabled"] {
    background-color: #4D4D4D;
    color: #808080;
}

QListView {
    background-color: #262626;
    color: #E0E0E0;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
    padding: 5px;
    font-size: 14px;
}

QListView::item {
    padding: 8px;
    border-radius: 5px;
}

QListView::item:hover,
QlistView::item:selected {
    background-color: #404040;
}

QScrollBar::vertical {
    background-color: #1F1F1F;
    width: 5px;
    margin: 0px;
    border-radius: 15px;
}

QScrollBar::handle::vertical {
    background-color: #13FC13;
    min-height: 10px;
    border-radius: 5px;
}

QScrollBar::handle::vertical:hover {
    background-color: #13FC5D;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical,
QScrollBar::add-page:vertical {
    background: #1F1F1F
}

QCheckBox {
    color: #E0E0E0;
    font-size: 14px;
    spacing: 8px;
}

QCheckBox::indicator {
    border: 1px solid #13FC13;
}

QCheckBox::indicator:checked,
QCheckBox::indicator:checked:hover {
    background-color: #15FC13;
}

QCheckBox::indicator:unchecked:hover {
    background-color: #262626;
}

QComboBox[styleTag="primaryComboBox"] {
    padding: 5px;
    border-radius: 3px;
    min-width: 60px;
    height: 30px;
    font-family: "Cairo"; 
    border: none;
}

QComboBox[styleTag="primaryComboBox"][state="enabled"] {
    background-color: #262626;
    color: #E0E0E0;
}

QComboBox[styleTag="primaryComboBox"][state="disabled"] {
    background-color: #4D4D4D;
    color: #808080;
}

QComboBox[styleTag="primaryComboBox"]::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 15px;
    border: none;
    background: transparent;
    border-top-right-radius: 3px;
}

QComboBox[styleTag="primaryComboBox"]::down-arrow {
    image: url('resources/icons/downarrow.png');
    width: 15px;
    height: 15px;
    right: 5px;
    border-radius: 10px;
}

QComboBox[styleTag="primaryComboBox"] QAbstractItemView {
    background-color: #262626;
    selection-background-color: #404040;
    color: #ffffff;
    font-family: "Cairo";
}

QComboBox[styleTag="primaryComboBox"] QAbstractItemView::item {
    padding: 3px;
    font-size: 18px;
}

QComboBox[styleTag="primaryComboBox"] QAbstractItemView::item::selected {
    padding: 7px;
}
QDateTimeEdit,
QDateTimeEdit[state="enabled"] {
    background-color: #262626;
    color: #E0E0E0;
    font-size: 14px;
    border-radius: 5px;
    height: 30;
    width: 200;
}

QDateTimeEdit[state="disabled"] {
    background-color: #4D4D4D;
    color: #808080;
}

QSpinBox,
QSpinBox[state="enabled"] {
    background-color: #262626;
    color: #E0E0E0;
    font-size: 14px;
    border-radius: 5px;
    height: 30;
    width: 200;
}

QMessageBox {
    background-color: #171717;
    color: #E0E0E0;
    font-size: 16px;
}

QMessageBox QPushButton {
    color: #E0E0E0;
    font-size: 12px;
    border-radius: 5px;
    height: 30px;
    min-width: 60px;
    padding: 7px;
    background-color: #EEE;
}